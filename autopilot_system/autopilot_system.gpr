with "config/autopilot_system_config.gpr";
project Autopilot_System is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Autopilot_System_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("autopilot_system.adb");

   package Compiler is
      for Default_Switches ("Ada") use Autopilot_System_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Autopilot_System;
